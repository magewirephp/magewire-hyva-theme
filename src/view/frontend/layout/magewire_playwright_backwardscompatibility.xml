<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="1column"
>
    <body>
        <referenceContainer name="content">
            <block name="magewire-hyva.playwright.backwards_compatibility.browser_events"
                   template="Magewirephp_MagewireHyvaTheme::tests/magewire/playwright/backwards_compatibility/browser_events.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\MagewireHyvaTheme\Magewire\Playwright\BackwardsCompatibility\BrowserEvents
                    </argument>
                </arguments>
            </block>

            <!-- emitUp(): grandparent > parent > (child, sibling), and an unrelated stranger. -->
            <block name="magewire-hyva.playwright.backwards_compatibility.emit_up.grandparent"
                   template="Magewirephp_MagewireHyvaTheme::tests/magewire/playwright/backwards_compatibility/emit_up.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\MagewireHyvaTheme\Magewire\Playwright\BackwardsCompatibility\EmitUp
                    </argument>
                </arguments>
                <block name="magewire-hyva.playwright.backwards_compatibility.emit_up.parent"
                       template="Magewirephp_MagewireHyvaTheme::tests/magewire/playwright/backwards_compatibility/emit_up.phtml"
                >
                    <arguments>
                        <argument name="magewire" xsi:type="object" shared="false">
                            Magewirephp\MagewireHyvaTheme\Magewire\Playwright\BackwardsCompatibility\EmitUp
                        </argument>
                    </arguments>
                    <block name="magewire-hyva.playwright.backwards_compatibility.emit_up.child"
                           template="Magewirephp_MagewireHyvaTheme::tests/magewire/playwright/backwards_compatibility/emit_up.phtml"
                    >
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Magewirephp\MagewireHyvaTheme\Magewire\Playwright\BackwardsCompatibility\EmitUp
                            </argument>
                        </arguments>
                    </block>
                    <block name="magewire-hyva.playwright.backwards_compatibility.emit_up.sibling"
                           template="Magewirephp_MagewireHyvaTheme::tests/magewire/playwright/backwards_compatibility/emit_up.phtml"
                    >
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Magewirephp\MagewireHyvaTheme\Magewire\Playwright\BackwardsCompatibility\EmitUp
                            </argument>
                        </arguments>
                    </block>
                </block>
            </block>
            <block name="magewire-hyva.playwright.backwards_compatibility.emit_up.stranger"
                   template="Magewirephp_MagewireHyvaTheme::tests/magewire/playwright/backwards_compatibility/emit_up.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\MagewireHyvaTheme\Magewire\Playwright\BackwardsCompatibility\EmitUp
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
