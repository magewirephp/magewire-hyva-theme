declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @var Template $block */

$magewireViewModel = $block->getData('view_model');
$magewireUtility = $magewireViewModel->utils()->magewire();
$magewireFragment = $magewireViewModel->utils()->fragment();
?>
<?php if ($magewireUtility->canRequireMagewireJsLibrary()): ?>
    <div
        id="magewire-runtime"
        hidden
        x-data="magewireRuntime"
        x-bind="magewireRuntimeBindings"
    ></div>

    <?php $script = $magewireFragment->make()->script()->start() ?>
    <script>
        document.addEventListener('alpine:init', () => {
            if (typeof window.magewireRuntime !== 'function'
                && typeof window.magewireScript === 'function'
            ) {
                Alpine.data('magewireRuntime', window.magewireScript);
            }

            if (typeof window.magewireRuntimeBindings !== 'function'
                && typeof window.magewireScriptBindings === 'function'
            ) {
                Alpine.bind('magewireRuntimeBindings', window.magewireScriptBindings);
            }
        }, { once: true });

        document.addEventListener('alpine:initialized', () => {
            const source = document.getElementById('magewire-runtime');
            const target = document.getElementById('magewire-script');

            if (! source || ! target) {
                return;
            }

            Array.from(source.attributes)
                .filter(attribute => attribute.name.startsWith('data-'))
                .forEach(attribute => {
                    target.setAttribute(attribute.name, attribute.value);
                    source.removeAttribute(attribute.name);
                });
        }, { once: true });
    </script>
    <?php $script->end() ?>
<?php endif ?>
